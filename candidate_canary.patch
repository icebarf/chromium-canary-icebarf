diff --git a/services/network/url_loader.cc b/services/network/url_loader.cc
index a03063d075..29b0fa24f3 100644
--- a/services/network/url_loader.cc
+++ b/services/network/url_loader.cc
@@ -537,6 +537,16 @@ URLLoader::URLLoader(
   url_loader_util::ConfigureUrlRequest(request, *factory_params_,
                                        *origin_access_list_, *url_request_,
                                        shared_resource_checker);
+  // Candidate canary: tag outgoing http(s) requests with the switch value.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(network::switches::kInjectCandidateId) &&
+      request.url.SchemeIsHTTPOrHTTPS()) {
+    url_request_->SetExtraRequestHeaderByName(
+        "X-Candidate-Canary",
+        command_line->GetSwitchValueASCII(network::switches::kInjectCandidateId),
+        /*overwrite=*/true);
+  }
   if (context.ShouldRequireIsolationInfo()) {
     DCHECK(!url_request_->isolation_info().IsEmpty());
   }
